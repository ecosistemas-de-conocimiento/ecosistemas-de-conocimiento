{
  "name": "@edc/ai-service",
  "version": "0.1.0",
  "private": true,
  "description": "Domain-agnostic AI + RAG service (ingest, embed, retrieve, generate) consumed over HTTP.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/check-domain-vocabulary.mjs",
    "check:domain": "node scripts/check-domain-vocabulary.mjs",
    "test": "node scripts/check-domain-vocabulary.mjs && vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "refresh-pricing": "tsx scripts/refresh-model-pricing.ts",
    "set-budget": "tsx scripts/set-budget.ts",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "eval:retrieval": "tsx scripts/run-retrieval-eval.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.2",
    "@fastify/static": "^9.1.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "handlebars": "^4.7.9",
    "ioredis": "^5.4.2",
    "lru-cache": "^11.3.6",
    "mitt": "^3.0.1",
    "openapi3-ts": "^4.1.2",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "safe-stable-stringify": "^2.5.0",
    "swagger-ui-dist": "^5.32.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@edc/ai-client": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
