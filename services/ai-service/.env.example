# ai-service — environment. Copy to `.env` and fill in.
#
# Everything here is read either by `src/config/env.ts` (Zod-validated at boot;
# an invalid value exits before the HTTP listener binds) or directly via
# `process.env` where noted. Defaults shown are the code's own defaults — a
# commented-out line means "the default is fine, set it only to change it".

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development                  # development | test | production
PORT=3000                             # HTTP listen port
HOST=0.0.0.0                          # listen address; 0.0.0.0 so containers can reach it
LOG_LEVEL=info                        # fatal|error|warn|info|debug|trace|silent (pino)
# Proxy hops in front of the service (Traefik = 1). Raise only for a CDN in front.
TRUSTED_PROXY_HOPS=1

# ─── Datastores (both REQUIRED — no defaults, boot fails without them) ──────
# Postgres MUST have the `vector` extension available; migration 0000 runs
# `CREATE EXTENSION vector`. The `pgvector/pgvector:pg16` image ships it.
DATABASE_URL=postgres://ai_service:ai_service@localhost:45432/ai_service
# Redis backs the BullMQ queues and the SSE event fan-out.
REDIS_URL=redis://localhost:45479

# ─── Auth: per-consumer bearer tokens ───────────────────────────────────────
# JSON map of apiKey -> { org, project, role?, delegateOrgPrefix?, callbackSecret?, previousCallbackSecrets? }.
# `role` is "app" (default, read + own-scope writes) or "admin" (registry/budget
# writes). `callbackSecret` must be 32+ chars — without it ai-service records but
# cannot SIGN async callbacks, and the receiver will reject them.
# `delegateOrgPrefix` (optional, must end in "-") lets ONE key act for many orgs:
# a request may send `X-AI-Org: <suffix>` (^[a-z0-9-]{1,48}$) and then acts as
# org `<prefix><suffix>` — its own budget, usage rows and corpora. No header =
# the entry's own `org`. The header on a key without a prefix is
# `403 org_delegation_forbidden`; a bad suffix is `400 invalid_org`. Another
# key's own `org` MAY start with a prefix: a dedicated key per sub-org shares
# that org with the delegating key. Each delegated org needs its budget: `POST /v1/tenant/provision` with the header provisions it.
# Parsed ONCE at boot: adding a key requires an env edit + restart.
API_KEYS={"dev-key-app":{"org":"demo","project":"demo","role":"app","callbackSecret":"replace-me-with-64-hex-chars-at-least-32-long"},"dev-key-admin":{"org":"demo","project":"demo","role":"admin"}}

# ─── LLM provider ───────────────────────────────────────────────────────────
# Platform-wide OpenRouter key. Required in production (boot aborts without it);
# in dev a missing key only warns, so mocked tests still run.
OPENROUTER_API_KEY=sk-or-v1-replace-me
# Optional fallback used ONLY by the embeddings client when OPENROUTER_API_KEY is absent.
# OPENAI_API_KEY=
# Sent as the OpenRouter `HTTP-Referer` attribution header (read via process.env).
# OPENROUTER_APP_URL=https://ecosistemas-de-conocimiento.local

# ─── Embeddings seam (dense vectors) ────────────────────────────────────────
# OpenAI-compatible /embeddings endpoint. Repoint at a self-hosted box in prod
# with no code change — same weights means identical vectors, no re-embed.
# EMBEDDINGS_URL=https://openrouter.ai/api/v1/embeddings
# Default model for auto-created corpora and the /v1/embed passthrough.
# EMBEDDING_MODEL=baai/bge-m3
# Vector length the model emits. MUST match the `chunks.embedding` vector(N)
# column — changing it needs a migration, so this is a consistency knob.
# EMBEDDING_DIM=1024

# ─── Rerank seam (cross-encoder, OFF by default) ────────────────────────────
# Master switch. When false the service never calls the reranker even if a
# request sets `rerank: true` — the field degrades to a no-op.
# RERANK_ENABLED=false
# Cohere-style POST /rerank endpoint of the sibling `rerank-service/`.
# NOT OpenRouter — it does not serve this model. Absent means rerank stays a no-op.
# RERANK_URL=http://rerank-service:8000/rerank
# RERANK_MODEL=baai/bge-reranker-v2-m3
# Wall-clock cap per rerank call. On timeout OR any error the service falls back
# to the fused order and never fails the query.
# RERANK_TIMEOUT_MS=5000
# Which wire shape RERANK_URL speaks: `rerank-api` (default; Cohere-style
# {model, query, documents} -> {results:[{index, relevance_score}]}) or
# `deepinfra` (RERANK_URL is then the API BASE and the model id is appended
# from RERANK_MODEL).
# RERANK_PROVIDER=rerank-api
# Bearer credential for RERANK_URL; omitted when unset. Mandatory for a hosted
# reranker — the boot refuses `deepinfra` without it.
# RERANK_API_KEY=
# Hosted example (DeepInfra):
# RERANK_ENABLED=true
# RERANK_PROVIDER=deepinfra
# RERANK_URL=https://api.deepinfra.com
# RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# RERANK_API_KEY=<deepinfra token>
# RERANK_TIMEOUT_MS=8000

# ─── Learned-sparse seam (bge-m3 lexical vectors, OFF by default) ───────────
# When false, ingest writes no `chunks.sparse_embedding` and hybrid retrieval
# uses the Postgres tsvector lexical leg. When true, sparse REPLACES that leg.
# SPARSE_ENABLED=false
# POST /embed endpoint of the sibling `bge-m3-service/`. OpenRouter cannot serve
# this: its /embeddings response has no field for sparse weights.
# SPARSE_EMBED_URL=http://bge-m3-service:8000/embed
# SPARSE_EMBED_MODEL=baai/bge-m3
# Sparse vocab size AND the `chunks.sparse_embedding` sparsevec(N) column width.
# Pinned to bge-m3's XLM-RoBERTa vocab; a mismatch aborts boot on purpose.
# SPARSE_DIM=250002
# SPARSE_TIMEOUT_MS=10000

# ─── Hybrid lexical leg (tsvector by default) ───────────────────────────────
# The leg a `mode: 'hybrid'` retrieve fuses with dense when sparse is off:
# tsvector (default; stems with the corpus `language`, `spanish` for EDC) |
# trigram (pg_trgm word_similarity over chunks.text; extension from migration
# 0005, no trigram index; no stemmer) | none (dense only).
# TRIGRAM_THRESHOLD is pg_trgm's word_similarity_threshold for the `<%` filter;
# the 0.3 default is untuned. Leave both unset to keep tsvector.
# HYBRID_LEXICAL_LEG=trigram
# TRIGRAM_THRESHOLD=0.3

# ─── Timeouts ───────────────────────────────────────────────────────────────
# Cap on the optional query-condensation call in front of /v1/retrieve/multi.
# On timeout it fails SAFE to the raw question. 0 disables the bound.
# CONDENSE_TIMEOUT_MS=5000
# Backstop on one whole LLM generation (including refine/sample passes).
# Combines with the client-disconnect AbortSignal. 0 disables.
# LLM_REQUEST_TIMEOUT_MS=120000
# Inactivity backstop on a STREAMING call: abort if no delta arrives for this
# long. Tighter than the total cap because a stalled stream is the likelier hang.
# LLM_STREAM_STALL_TIMEOUT_MS=45000
# Async generation worker's own wall-clock cap. Unset = inherit
# LLM_REQUEST_TIMEOUT_MS. Positive integer only.
# LLM_ASYNC_REQUEST_TIMEOUT_MS=600000
# BullMQ per-job lock window. Unset = derived from the LLM timeouts (60 s floor).
# WORKER_LOCK_DURATION_MS=240000
# How long SIGTERM lets in-flight jobs finish before aborting them. The
# platform's stop grace (compose `stop_grace_period`) MUST exceed it — Docker
# SIGKILLs after 10 s by default.
# SHUTDOWN_GRACE_MS=30000

# ─── Provider endpoint (there is NO mock mode) ──────────────────────────────
# OpenAI-compatible /chat/completions endpoint for both chat paths.
# CHAT_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions
# ⚠ MOCK_LLM, MOCK_EMBEDDINGS and MOCK_LLM_STREAM were REMOVED; setting any of
# them refuses boot in every environment. For tests and local demos run the
# TEST-ONLY fake provider (`test-support/fake-provider/README.md`) and point
# CHAT_COMPLETIONS_URL + EMBEDDINGS_URL at it.

# ─── Callback SSRF guard ────────────────────────────────────────────────────
# Callback targets resolving to loopback / RFC1918 / link-local / IPv6-ULA are
# refused (400 at enqueue, terminal `failed` at delivery). LOCAL docker stacks
# that call back `http://<service>:<port>` need this on; it is FORBIDDEN in
# production (NODE_ENV=production refuses to boot with it set), where the
# callback target must be a public hostname.
# CALLBACK_ALLOW_PRIVATE=false

# ─── Shared rate-limit store ────────────────────────────────────────────────
# The /v1 rate limiter shares its buckets through REDIS_URL everywhere except
# NODE_ENV=test. `1` forces the shared store on, `0` forces the in-process one.
# The limiter FAILS OPEN while that Redis is unreachable.
# RATE_LIMIT_REDIS=

# ─── Observability ──────────────────────────────────────────────────────────
# Tracing is OFF unless this is set (OTLP/HTTP base URL; spans only, no logs).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.internal:4318
# OTEL_SERVICE_NAME=ai-service
# GET /metrics (prometheus). Set: bearer token required from any address.
# Unset: served to a loopback peer only.
# METRICS_TOKEN=

# ─── PII NER detector (optional sibling, fails CLOSED when installed) ───────
# PII_NER_URL=http://pii-service:8000/ner
# PII_NER_MODEL=
# PII_NER_BATCH_LIMIT=16
# PII_NER_TIMEOUT_MS=5000
# PII_NER_MIN_SCORE=0.5

# ─── Integration + eval harness (test-time only) ────────────────────────────
# `src/test/integration-setup.ts` rebinds these onto DATABASE_URL / REDIS_URL
# before any module imports config/env.ts. Point them at a THROWAWAY database —
# the suite truncates tables.
# TEST_DATABASE_URL=postgres://ai_service:ai_service@localhost:45432/ai_service
# TEST_REDIS_URL=redis://localhost:45479
# Host ports for the throwaway containers two suites spin up themselves.
# Override when the shared local stack already owns the default port.
# AI_SVC_TEST_PG_PORT=45432
# AI_SVC_TEST_TENANT_PG_PORT=55433
# Retrieval-eval knobs (`pnpm eval:retrieval`).
# EVAL_TOP_K=8
# Opt-in to REAL embedding calls in the eval — costs real money per run.
# EVAL_REAL_EMBEDDER=1

# ─── Post-deploy smoke (scripts/smoke.sh, scripts/smoke.spec.ts) ────────────
# AI_SERVICE_URL=https://ai.example.com
# AI_SERVICE_SMOKE_TOKEN=dev-key-app
# AI_SERVICE_ORG=demo
