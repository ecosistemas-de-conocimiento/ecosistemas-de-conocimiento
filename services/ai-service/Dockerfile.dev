# syntax=docker/dockerfile:1
#
# ai-service — LOCAL DEV image (hot-reload). NOT for stage/prod (that is the
# multi-stage `Dockerfile`).
#
# ⚠ BUILD CONTEXT IS THE REPO ROOT — see the note in `Dockerfile`.
#
# Model:
#   - the repo is BIND-MOUNTED at /repo at runtime by the root compose (so edits
#     hot-reload via `tsx watch`); this image only bakes the toolchain + deps.
#   - node_modules lives in NAMED VOLUMES mounted at /repo/node_modules and
#     /repo/services/ai-service/node_modules, so the pnpm symlink farm survives
#     the source bind-mount overlay and avoids host/container native-binary
#     mismatch (esbuild's platform binary). The deps baked here seed those
#     volumes on first run.
#   - runs as a NON-ROOT user.
#   - secrets are runtime-only env (compose `env_file`), never build args.

# ⚠ The node major here, in `Dockerfile` (all stages) and in `.nvmrc` must
# AGREE — `src/config/toolchain-pins.test.ts` fails the build if they drift.
FROM node:26-bookworm-slim

ENV NODE_ENV=development
ENV PORT=3000
ENV HOST=0.0.0.0
# Node 26 no longer bundles corepack; pin pnpm to the root `packageManager`.
RUN npm install -g pnpm@9.15.4
WORKDIR /repo

# Manifests first (cacheable install layer). This list must track
# `pnpm-workspace.yaml` — pnpm validates `--frozen-lockfile` against every
# workspace manifest.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/backend/package.json apps/backend/
COPY packages/ai-client/package.json packages/ai-client/
COPY packages/identity-client/package.json packages/identity-client/
COPY packages/chat-engine/package.json packages/chat-engine/
COPY services/ai-service/package.json services/ai-service/

# Dependency lifecycle scripts are blocked by pnpm 9's default build-script
# policy; the root `pnpm-workspace.yaml` allowlists the few that genuinely need
# one (`onlyBuiltDependencies`). See SECURITY-LOCAL.md.
RUN pnpm install --filter @edc/ai-service... --frozen-lockfile

# Bring in the service source so the image is runnable standalone. The compose
# bind-mount overlays /repo at runtime for hot-reload; node_modules is masked by
# its own named volumes.
COPY services/ai-service ./services/ai-service

# Drop root. The node image ships a `node` user. Own /repo (incl. the seeded
# node_modules) so the named-volume seed and any tsx cache writes succeed.
RUN chown -R node:node /repo
USER node

WORKDIR /repo/services/ai-service
EXPOSE 3000

# Default dev command: hot-reloading server bound to 0.0.0.0:3000 (env above).
# The root compose may override `command:`; this is the documented default.
CMD ["pnpm", "run", "dev"]
