# audio-service — environment. Copy to `.env` and fill in.
#
# Every value here is read by `app/config.py`, validated at boot, and an invalid
# one aborts the process before the HTTP listener binds. Commented-out lines
# show the code's own default — set them only to change them.
#
# ⚠ Placeholders below are PLACEHOLDERS. Nothing here is a real credential.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development                  # development | test | production
HOST=0.0.0.0                          # 0.0.0.0 so other containers can reach it
PORT=8080                             # honoured by the image CMD; root compose sets 8080
LOG_LEVEL=INFO                        # CRITICAL|ERROR|WARNING|INFO|DEBUG

# ─── Datastore (the ONLY one — no Postgres) ─────────────────────────────────
# Redis backs the arq queue, the job-status rows, the transcripts (TTL'd) and
# the callback delivery rows. Nothing here is a system of record: the signed
# callback is the durable handoff to the consumer.
REDIS_URL=redis://redis:6379/2

# ─── Auth: per-consumer bearer tokens ───────────────────────────────────────
# JSON map of apiKey -> { org, project, role?, callbackSecret? }. Identical
# shape and semantics to ai-service's API_KEYS — the same blob works in both.
#
# ⚠ `callbackSecret` MUST equal the value of `CALLBACK_SECRET` in apps/backend,
#   because the backend verifies ai-service's and audio-service's callbacks
#   with the same secret and the same verifier (`src/lib/hmac.ts`).
# Parsed ONCE at boot: adding a key needs an env edit + restart.
API_KEYS={"replace-me-audio-app-key":{"org":"demo","project":"demo","role":"app","callbackSecret":"replace-me-with-a-64-hex-char-secret-at-least-32-long"},"replace-me-audio-admin-key":{"org":"demo","project":"demo","role":"admin"}}

# ─── Whisper backend ─────────────────────────────────────────────────────────
# local  : faster-whisper in the worker (everything below applies). Default.
# remote : POST each chunk to whisper.cpp whisper-server (README §"Remote GPU
#          backend"). The token is required in practice behind the Spark proxy.
# WHISPER_BACKEND=local
# WHISPER_REMOTE_URL=<spark-url>
# WHISPER_REMOTE_TIMEOUT_S=1800
# WHISPER_REMOTE_TOKEN=replace-me
# WHISPER_REMOTE_MODEL=large-v3      (label for callbacks only)

# ─── Whisper: THE two knobs that make one image run on CPU and GPU ──────────
# Local Docker on CPU (the default):
#   WHISPER_DEVICE=cpu
#   WHISPER_COMPUTE_TYPE=int8
# On a GPU host:
#   WHISPER_DEVICE=cuda
#   WHISPER_COMPUTE_TYPE=float16     (int8_float16 if VRAM is tight)
# Nothing else changes. No code change, no API change, no re-bake.
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# Weights. MUST match the `--build-arg WHISPER_MODEL=...` the image was baked
# with, or the container tries to download at boot and fails (HF_HUB_OFFLINE=1).
#   large-v3-turbo  default. Best quality/speed balance on CPU. ~800 MB int8.
#   large-v3        best Spanish accuracy, several times slower to decode.
#   medium / small  progressively faster and less accurate; `small` (~250 MB)
#                   is the right pick for a laptop demo.
# An explicit HuggingFace repo id also works, and is the fallback if a
# shorthand is not recognised by the installed faster-whisper version:
#   deepdml/faster-whisper-large-v3-turbo-ct2
#   Systran/faster-whisper-large-v3
#   Systran/faster-whisper-small
# WHISPER_MODEL=large-v3-turbo

# CTranslate2 intra-op threads. 0 -> use every core.
# WHISPER_CPU_THREADS=0
# Model replicas inside ONE process. Each is a full copy of the weights in RAM —
# leave at 1 and scale with worker containers.
# WHISPER_NUM_WORKERS=1

# Transcription language. "es" for this product. Empty string forces
# autodetection, which mis-detects short Spanish clips as Portuguese often
# enough to be worth avoiding.
# WHISPER_LANGUAGE=es
# WHISPER_BEAM_SIZE=5
# Silero VAD trims non-speech before decoding: faster AND far fewer
# hallucinated segments over silence.
# WHISPER_VAD_FILTER=true
# WHISPER_VAD_MIN_SILENCE_MS=500
# Feeding the previous window back into the decoder is Whisper's classic
# repetition-loop trigger on long recordings. Keep this false.
# WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
# Nudges the decoder into Spanish orthography from the first window.
# WHISPER_INITIAL_PROMPT=Transcripción en español.
# Where the baked weights live inside the image.
# WHISPER_DOWNLOAD_ROOT=/opt/whisper-cache

# ─── Audio handling ─────────────────────────────────────────────────────────
# Scratch space. Transient by design — audio is deleted the moment its
# transcript is produced, and swept on a timer if a crash skips that.
# AUDIO_WORK_DIR=/var/lib/audio-service
# Upload cap, enforced WHILE streaming to disk. 512 MiB ~= 9h of 128 kbps mp3.
# MAX_UPLOAD_BYTES=536870912
# Duration cap, enforced after ffprobe. 6 hours.
# MAX_DURATION_SECONDS=21600
# Long-recording chunking. Boundaries land on detected silences near the target;
# MAX is the hard ceiling when no silence is found.
# CHUNK_TARGET_SECONDS=600
# CHUNK_MAX_SECONDS=900
# CHUNK_SILENCE_SEARCH_SECONDS=60
# SILENCE_NOISE_DB=-32
# SILENCE_MIN_DURATION_SECONDS=0.45
# FFMPEG_TIMEOUT_SECONDS=1800
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# Orphan sweep age — files this old are deleted even if no job claims them.
# AUDIO_RETENTION_SECONDS=21600

# ─── Queue ──────────────────────────────────────────────────────────────────
# QUEUE_NAME=audio:transcribe
# 🔴 Callback deliveries run on their OWN queue and their OWN process
# (`arq app.worker.CallbackWorkerSettings`). They must not share the
# transcription queue: it runs one job at a time with a timeout measured in
# hours, so a delivery behind a running decode would wait for it to finish.
# CALLBACK_QUEUE_NAME=audio:callbacks
# CALLBACK_WORKER_MAX_JOBS=8
# Jobs processed concurrently in ONE worker. 1 is right on CPU: a single
# transcription already saturates every core.
# MAX_CONCURRENT_JOBS=1
# Per-attempt wall clock. Must exceed the worst case for MAX_DURATION_SECONDS.
# JOB_TIMEOUT_SECONDS=14400
# Attempts before dead-letter. Matches ai-service's BullMQ `attempts: 3`.
# Content errors (no audio stream, empty file, over the cap) never retry.
# JOB_MAX_TRIES=3
# JOB_RETRY_BACKOFF_SECONDS=[30,120]
# WORKER_HEARTBEAT_SECONDS=20
# Grace before a job with no heartbeat is declared abandoned and dead-lettered.
# Covers arq's job_timeout cancellation (an asyncio.CancelledError, which no
# `except Exception` can catch) and a SIGKILLed worker.
# STALE_JOB_GRACE_SECONDS=600

# ─── TTLs ───────────────────────────────────────────────────────────────────
# After this, GET /v1/transcribe/:id stops answering. The callback is the
# durable handoff; the consumer must persist the transcript on receipt.
# JOB_TTL_SECONDS=86400
# TRANSCRIPT_TTL_SECONDS=86400
# IDEMPOTENCY_TTL_SECONDS=86400

# ─── Callbacks ──────────────────────────────────────────────────────────────
# CALLBACK_TIMEOUT_SECONDS=20
# Transcripts longer than this are NOT inlined in the callback; the envelope
# sets `transcript.truncated: true` and the consumer must GET the full text.
# CALLBACK_MAX_TRANSCRIPT_CHARS=200000
# CALLBACK_PROGRESS_MIN_INTERVAL_SECONDS=30
# CALLBACK_TTL_SECONDS=604800

# ─── Tests ──────────────────────────────────────────────────────────────────
# Opt in to the real end-to-end Spanish transcription test. Requires the model
# to be present and a fixture built by scripts/make-fixtures.sh. Skipped
# otherwise — see tests/test_transcribe_e2e.py.
# AUDIO_E2E=1
