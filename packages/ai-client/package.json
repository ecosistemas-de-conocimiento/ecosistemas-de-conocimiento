{
  "name": "@edc/ai-client",
  "version": "0.31.0",
  "description": "Typed TypeScript client for the AI/RAG service (`ai-service`).",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./callbacks": {
      "types": "./dist/callbacks/index.d.ts",
      "import": "./dist/callbacks/index.js"
    },
    "./callbacks/claims": {
      "types": "./dist/callbacks/claims/index.d.ts",
      "import": "./dist/callbacks/claims/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:error-parity": "node scripts/check-error-parity.mjs"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24 || ^26"
  }
}
