{
  "name": "@edc/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3002}",
    "build": "next build",
    "start": "sh scripts/migrate.sh && next start -p ${PORT:-3002}",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.eval.json --noEmit",
    "generate:types": "payload generate:types",
    "generate:schema": "payload generate:db-schema",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "keygen": "payload run src/lib/jwt/keygen.ts",
    "seed:demo": "payload run src/seed/demo.cli.ts",
    "seed:demo-users": "payload run src/seed/demoUsers.cli.ts",
    "seed:semiosis-demo": "payload run src/seed/semiosisDemo.cli.ts",
    "provision:storage": "payload run scripts/provision-storage.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d --wait"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/lib-storage": "^3.1049.0",
    "@edc/ai-client": "workspace:*",
    "@edc/chat-engine": "workspace:*",
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-s3": "^3.84.1",
    "graphql": "^16.8.1",
    "jose": "^5.9.6",
    "mammoth": "^1.12.0",
    "next": "15.4.11",
    "parse5": "^8.0.1",
    "payload": "^3.84.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^9.3.12",
    "tsx": "4.22.4",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.4.11",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.9"
  }
}
