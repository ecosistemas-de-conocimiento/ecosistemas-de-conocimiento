# @edc/backend — every environment variable this app reads.
#
# Copy to `.env` and fill in. Values here are PLACEHOLDERS, never real secrets.
# Anything marked REQUIRED has no working default.

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Postgres connection string. Port 5433 matches docker-compose.yml.
DATABASE_URI=postgres://edc:edc_local_dev@localhost:5433/edc_backend_dev

# REQUIRED. Signs Payload's own session cookies. 64 hex chars.
# ⚠ This NEVER signs an identity token — that is AUTH_PRIVATE_KEY below.
# Different key, different job, different blast radius.
PAYLOAD_SECRET=replace-with-64-hex-chars

# Port the server listens on. Defaults to 3002.
PORT=3002

# Which DEPLOYMENT this is: local | dev | demo-0 | stage | prod.
# ⚠ Gates demo seeding, and FAILS CLOSED — unset means no demo content at all.
# It is the environment's NAME, not its type. NODE_ENV cannot substitute: every
# deployed environment, deployed dev included, runs NODE_ENV=production.
EDC_ENV=local

# Comma-separated browser origins allowed for CORS *and* CSRF.
# Empty falls back to localhost:5173 / :4173 for local development.
ALLOWED_ORIGINS=http://localhost:5173

# Set to 1 to ALLOW Payload's schema push. Unset = migrations only, everywhere.
# ✅ Leave it unset. The baseline migration exists and `payload migrate` (which
#    the `start` script and the dev image's CMD both run) builds the schema in
#    every environment, laptop included. Nothing needs push to get a schema.
# ⚠ Push can DROP the four hand-written indexes in the baseline, including the
#   three compound UNIQUE ones that stop duplicate ratings / memberships /
#   callback rows. It removes them without erroring.
# 🔴 The gate is opt-IN on purpose. Under the old opt-out gate, one forgotten
#   variable in one environment silently lost those locks. Turn it on only to
#   iterate on the schema locally, and cut a migration afterwards rather than
#   leaving the database in that state. See src/migrations/README.md.
# PAYLOAD_ALLOW_PUSH=1

# ─────────────────────────────────────────────────────────────────────────────
# Identity provider — token signing
#
# Generate a keypair with:  pnpm --filter @edc/backend keygen
# ⚠ AUTH_PRIVATE_KEY is the highest-value secret here. Whoever holds it can mint
# any claim for any user in any organization until AUTH_KEY_ID is rotated AND
# every verifier's JWKS cache expires (up to an hour).
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED to issue tokens. Ed25519 PKCS#8 PEM; newlines escaped as \n.
AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"

# REQUIRED to publish JWKS. Ed25519 SPKI PEM. Unset ⇒ an EMPTY key set is
# served and every consumer fails verification.
AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"

# `kid` stamped on tokens and published in the JWK Set. Bump on every rotation.
AUTH_KEY_ID=edc-2026-01

# REQUIRED to issue tokens. The `iss` claim — this backend's public origin.
AUTH_ISSUER=http://localhost:3002

# Access-token lifetime in seconds. Clamped to [30, 900]; 900 is a hard cap.
AUTH_TOKEN_TTL=900

# JSON map of consumer-slug -> shared secret, for `GET /v1/identity/resolve`.
# ⚠ Server-side only. Anything that reaches a browser compromises the whole
# grant-lookup surface. Empty ⇒ every service-to-service call is rejected.
SERVICE_TOKENS={"ai-service":"replace-with-a-long-random-secret"}

# Optional. Restrict sign-up to one email domain (public signup is ON).
# IDENTITY_ALLOWED_EMAIL_DOMAIN=example.org

# How many trusted proxies sit in front of this app, for per-IP rate limiting.
# ⚠ Too HIGH is a silent, total bypass of every per-IP bucket. Default 1.
# IDENTITY_TRUSTED_PROXY_HOPS=1

# ─────────────────────────────────────────────────────────────────────────────
# Identity provider — rate limits (per 60s). Defaults shown; raise without a
# code deploy. ⚠ Counters are IN-PROCESS: N replicas allow N× each limit.
# ─────────────────────────────────────────────────────────────────────────────

# IDENTITY_RATELIMIT_TOKEN_USER_MAX=30
# IDENTITY_RATELIMIT_TOKEN_IP_MAX=120
# IDENTITY_RATELIMIT_ME_USER_MAX=60
# IDENTITY_RATELIMIT_ME_IP_MAX=240
# IDENTITY_RATELIMIT_RESOLVE_CONSUMER_MAX=600
# IDENTITY_RATELIMIT_SERVICE_AUTH_FAIL_IP_MAX=20

# ─────────────────────────────────────────────────────────────────────────────
# Bootstrap admin
# ─────────────────────────────────────────────────────────────────────────────

# Email of the first account, created only when the users table is EMPTY.
SEED_ADMIN_EMAIL=admin@ecosistemas.test

# ⚠ REQUIRED for any admin to be created, on EVERY environment including local.
# There is deliberately no default: this app holds the token signing key, so a
# committed credential is a total compromise. Unset ⇒ the seed skips loudly and
# you create the first user through /admin instead.
SEED_ADMIN_PASSWORD=replace-with-a-real-password

# Set to 0 or false to turn demo seeding OFF inside an environment that allows
# it. ⚠ It can only ever NARROW — it can never turn seeding ON.
# SEED_DOMAIN=0

# ─────────────────────────────────────────────────────────────────────────────
# ai-service
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of ai-service. Required for document ingest and for readiness.
AI_SERVICE_URL=http://localhost:3001

# App-role bearer. Used for ingest enqueue and the boot capability check.
# ⚠ ai-service reads {org, project} from THIS key, at ITS boot — not from our
# requests. So every ecosistema looks like one org to it, and isolation is
# enforced HERE, by corpus name (`eco-{orgId}` / `eco-{orgId}-draft-{userId}`).
# See src/lib/corpus.ts.
# ⚠ Budget is keyed on that one org, so all ecosistemas share one spend cap.
AI_SERVICE_API_KEY=replace-me

# Admin-role bearer. Required for corpus deletion; the app key would 403.
AI_SERVICE_ADMIN_API_KEY=replace-me

# ─────────────────────────────────────────────────────────────────────────────
# Anonymisation detector — self-hosted backend (optional)
#
# Set ANONYMISE_DETECT_URL to send the gate's detector calls (raw testimony) to
# our own OpenAI-compatible server instead of ai-service → hosted model.
# 🔴 Fail closed: when set, an unreachable server HOLDS documents; there is no
# fallback to ai-service. Unset = ai-service, as before.
# Calls hit ${ANONYMISE_DETECT_URL}/v1/chat/completions. MODEL is required.
# ─────────────────────────────────────────────────────────────────────────────
# ANONYMISE_DETECT_URL=https://spark.example:8443
# ANONYMISE_DETECT_API_KEY=replace-me
# ANONYMISE_DETECT_MODEL=Qwen3-30B-A3B-Instruct-2507

# `strict` throws at boot when a required ai-service capability is missing;
# `warn` logs and continues. Defaults to strict on NODE_ENV=production.
# AI_CAPABILITY_MODE=warn

# ─────────────────────────────────────────────────────────────────────────────
# ai-service → backend callbacks
#
# ⚠ BOTH are required or callbacks are OFF, and every uploaded PDF/DOCX sits in
# ingestStatus="embedding" forever with no error anywhere.
# ─────────────────────────────────────────────────────────────────────────────

# Shared HMAC secret. Must equal this API key's `callbackSecret` on ai-service.
CALLBACK_SECRET=replace-with-64-hex-chars

# Public origin of THIS backend, absolute, reachable FROM ai-service — which is
# not the same as reachable from your browser.
PUBLIC_BACKEND_URL=http://localhost:3002

# ─────────────────────────────────────────────────────────────────────────────
# audio-service — turning an uploaded recording into text
#
# ⚠ THERE IS NO SEPARATE CALLBACK SECRET. audio-service signs its callbacks with
# the SAME scheme and the SAME header names as ai-service (X-AIService-*), on
# purpose, so one verifier and one receiver route serve both. The
# `callbackSecret` on audio-service's API key entry MUST equal CALLBACK_SECRET
# above. Get that wrong and transcriptions succeed while every webhook 401s —
# audio-service records them as `auth_failed`, visible at
# GET /v1/admin/dead-letters?queue=callback.
#
# ⚠ Unset ⇒ audio uploads FAIL VISIBLY (ingestStatus="failed", with a reason the
# user can see and retry). They do not hang. PDF/DOCX/markdown are unaffected.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of audio-service. Absolute http(s) URL.
AUDIO_SERVICE_URL=http://localhost:8080

# App-role bearer from audio-service's API_KEYS map.
# ⚠ Same caveat as AI_SERVICE_API_KEY: audio-service reads {org, project} from
# THIS key at ITS boot, never from our requests, so it provides NO per-ecosistema
# isolation in this deployment. Isolation is enforced here — by Payload access
# control on `documents` and by the corpus name in src/lib/corpus.ts.
AUDIO_SERVICE_API_KEY=replace-me

# ─────────────────────────────────────────────────────────────────────────────
# Stalled-transcription sweep. ON by default — see src/lib/transcriptionJanitor.ts.
#
# 🔴 It covers the one audio failure NO health check can see: with the
# `audio-service-callbacks` container missing or dead, every transcription
# succeeds and not one webhook is delivered, so documents wait in
# ingestStatus="transcribing" forever and look exactly like ones still working.
# This sweep converts that into a visible, RETRYABLE failure. It never deletes.
#
# The deadline is per-document (4× the recording's own duration, floor 90 min),
# not a constant: transcription runs at ~1× realtime, so one fixed number is
# either too short for long recordings or useless for short ones.
# ─────────────────────────────────────────────────────────────────────────────

# TRANSCRIPTION_JANITOR_ENABLED=false
# TRANSCRIPTION_JANITOR_INTERVAL_MIN=15

# ─────────────────────────────────────────────────────────────────────────────
# Stalled-PUBLISH sweep. ON by default — see src/lib/publishJanitor.ts.
#
# 🔴 `publicationStatus: 'publishing'` is the second non-terminal state this
# backend has, and until now nothing watched it. A 250-document seed left 145
# rows stuck there — 99 with NO error and NO ingest id, because ai-service's
# rate limiter refused the enqueue AFTER the row had already been flipped to the
# in-flight state. Frozen for 25+ minutes with nothing to move them.
#
# ⚠ It writes ONE text field and nothing else. It never changes the status,
# never re-publishes, never touches a corpus — re-driving 145 publishes on a
# timer would recreate the very rate-limit burst it is cleaning up after, and
# an accepted ingest's outcome cannot be known from here anyway.
#
# The deadline is a constant, unlike the transcription one: an embed's duration
# is a property of ai-service's queue, not of the document.
# ─────────────────────────────────────────────────────────────────────────────

# PUBLISH_JANITOR_ENABLED=false
# PUBLISH_JANITOR_INTERVAL_MIN=15
# PUBLISH_JANITOR_STUCK_MIN=30

# ─────────────────────────────────────────────────────────────────────────────
# Backing off when ai-service rate-limits us — see src/lib/aiRetry.ts.
#
# ai-service caps /v1 at 100 req/min and /v1/generate at 30 (its own decision;
# the consumer is what changes). Every ingest enqueue now waits the number the
# server asks for, plus jitter, and gives up with a VISIBLE error.
#
# ⚠ The default budget is small ON PURPOSE: `beginPublish` runs inside an HTTP
# request a person is waiting on, and every second slept holds that connection
# open. Raise both for a bulk seed, where nobody is waiting.
# ─────────────────────────────────────────────────────────────────────────────

# AI_RETRY_MAX_ATTEMPTS=4
# AI_RETRY_TOTAL_WAIT_MS=120000

# ─────────────────────────────────────────────────────────────────────────────
# Session janitor — reaps stale sessions and their corpora. OFF by default.
# ─────────────────────────────────────────────────────────────────────────────

# SESSION_JANITOR_ENABLED=true
# SESSION_JANITOR_INTERVAL_MIN=1440
# SESSION_TTL_DAYS=90
# SESSION_JANITOR_BATCH=50
# SESSION_JANITOR_MAX=500
# SESSION_JANITOR_DRY_RUN=true

# ─────────────────────────────────────────────────────────────────────────────
# Object storage — where uploaded files actually live
#
# Set ALL FIVE, or NONE of them.
#   · All five  ⇒ uploads go to the bucket (RustFS locally: rustfs/rustfs:1.0.0-rc.1).
#   · None      ⇒ uploads go to LOCAL DISK (./media), which is what makes a bare
#                 `pnpm dev` work with no containers. Fine for a laptop; not
#                 durable anywhere else.
#   · 🔴 SOME   ⇒ still local disk, and the boot log says so AT ERROR. This is
#                 the failure that actually bites: S3_ENDPOINT set, secret
#                 forgotten, every upload landing on a container filesystem the
#                 next redeploy throws away. Nothing else warns you.
#
# ⚠ AN EMPTY VALUE COUNTS AS UNSET, deliberately. Docker compose cannot express
# "absent" — `${S3_ENDPOINT:-}` sets an empty string — so `S3_ENDPOINT=` and no
# `S3_ENDPOINT` line at all behave identically. Comment a line out or leave it
# blank; either works.
#
# The boot log always names the active mode. Check it after any change here.
#
# 🔴 FILES ARE ALWAYS SERVED THROUGH THIS APP. No presigned URLs are issued
# anywhere, on purpose: a presigned URL bypasses Payload and with it every access
# rule in src/collections/Media.ts — the uploader-only draft rule included. See
# src/lib/storage/plugin.ts before touching any of this.
#
# ⚠ RustFS is LOCAL AND DEV ONLY. Stage and prod are out of scope for these vars.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the S3-compatible store. Path-style addressing is forced by the
# client (no bucket subdomains), which RustFS and MinIO both require.
# From the HOST: port 45410 (this repo's data-tier +50000 offset; the console is
# on 45411 at /rustfs/console/). From INSIDE compose: http://rustfs:9000.
# S3_ENDPOINT=http://localhost:45410

# Ignored by RustFS, but the AWS SDK refuses to build a client without one and
# SigV4 signs over it. Defaults to us-east-1; just keep it consistent.
# S3_REGION=us-east-1

# Bucket name. Defaults to `edc`. The same literal on every environment.
# S3_BUCKET=edc

# The APPLICATION credential — scoped to this bucket, NOT the store's root key.
# ⚠ Its policy must grant s3:* on BOTH arn:aws:s3:::edc and arn:aws:s3:::edc/*.
#   Only the bucket ARN, and every object call 403s.
# 🔴 The store keeps its user database on the DATA VOLUME and no env var seeds
#   it. `docker compose down -v` deletes this credential, and then every call
#   fails with InvalidAccessKeyId until it is re-created. That is why
#   provisioning is a script you can re-run (`pnpm provision:storage`) and not a
#   one-shot init container.
# S3_ACCESS_KEY_ID=edc-app
# S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret

# OPTIONAL, and read by `pnpm provision:storage` ONLY — never by the running app.
# A correctly scoped application key usually cannot CreateBucket, which is the
# point of scoping it. Give the provisioning script the root credential and it
# creates the bucket as root while still testing every other call as the app.
# S3_ROOT_ACCESS_KEY_ID=rustfsadmin
# S3_ROOT_SECRET_ACCESS_KEY=rustfsadmin

# ─────────────────────────────────────────────────────────────────────────────
# Local Postgres container (docker-compose.yml only — the app never reads these)
# ─────────────────────────────────────────────────────────────────────────────

# POSTGRES_DB=edc_backend_dev
# POSTGRES_USER=edc
# POSTGRES_PASSWORD=edc_local_dev
# POSTGRES_PORT=5433

# ─────────────────────────────────────────────────────────────────────────────
# Corpus graph (/grafo) — see src/lib/graph/queries.ts, "Configuration".
#
# Every value is a positive integer; junk, 0 or a negative falls back to the
# default. Published-only, gate-cleared text, the noise filters (languages,
# redaction placeholders) and "a persona only from a documento" are NOT
# configurable and apply to every read, co-mentions included.
# ⚠ GRAPH_MIN_SUPPORT is no longer read. It was replaced by the two below.
# ─────────────────────────────────────────────────────────────────────────────

# Distinct published documents that must mention an entity before it shows.
# GRAPH_MIN_ENTITY_DOCS=1
# Distinct published documents behind any relation of one PAIR of entities
# (any type, either direction) before the pair is drawn as a relation edge.
# GRAPH_MIN_EDGE_DOCS=1
# Shared published documents before two entities are linked as "aparecen juntos".
# GRAPH_MIN_COMENTION_DOCS=1
# Co-mention edges each entity keeps, strongest first (max 50). A pair is kept
# when either end keeps it.
# GRAPH_COMENTION_TOP_K=8
