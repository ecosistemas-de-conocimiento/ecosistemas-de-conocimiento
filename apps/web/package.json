{
  "name": "@edc/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.15.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@types/three": "~0.186.0",
    "autoprefixer": "^10.4.20",
    "happy-dom": "20.11.2",
    "jsdom": "27.4.0",
    "postcss": "^8.4.49",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "3d-force-graph": "1.80.1",
    "@edc/ai-client": "workspace:*",
    "@edc/chat-engine": "workspace:*",
    "dompurify": "^3.4.4",
    "force-graph": "1.52.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "three": "0.186.1"
  }
}
