{
  "name": "ecosistemas-de-conocimiento",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multitenant content repository with a knowledgebase: document upload, RAG chat sessions, rated answers.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:sequential": "pnpm -r --workspace-concurrency=1 test",
    "dev:web": "pnpm --filter @edc/web dev",
    "dev:backend": "pnpm --filter @edc/backend dev",
    "dev:ai": "pnpm --filter @edc/ai-service dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait"
  },
  "pnpm": {
    "overrides": {
      "shell-quote@<1.11.0": "1.11.0",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "devalue@<5.9.3": "5.9.3",
      "dompurify@<3.4.17": "3.4.17",
      "happy-dom@<21.0.4": "21.0.4",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "postcss@<8.5.18": "8.5.23",
      "sharp@<0.35.5": "0.35.5",
      "source-map-js@<1.2.2": "1.2.2",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "zod@>=4.0.0 <4.6.6": "4.6.7",
      "brace-expansion@<1.1.20": "1.1.20",
      "node-forge@<1.4.1": "1.4.1",
      "follow-redirects@>=1.16.0 <1.16.2": "1.16.2",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "mongoose@>=9.0.0 <9.11.4": "9.11.4",
      "fast-uri@<3.1.9": "3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "4.2.3",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "fast-copy@>=3.0.0 <3.1.0": "3.1.0"
    }
  }
}
